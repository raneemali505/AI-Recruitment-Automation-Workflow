    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst updatedItems = items.map((item) => {\n  const hasAttachment = item?.json?.payload?.mimeType === \"multipart/mixed\";\n  const parts = item?.json?.payload?.parts;\n  const attachmentName = hasAttachment\n    ? parts?.[1]?.filename ?? null\n    : null;\n  const attachmentMimeType = hasAttachment\n    ? parts?.[1]?.mimeType ?? null\n    : null;\n\n  return {\n    json: {\n      sender_name: item?.json?.From,\n      sender_email: item?.json?.To,\n      subject: item?.json?.Subject,\n      body: item?.json?.snippet,\n      hasAttachment,\n      attachmentName,\n      attachmentMimeType,\n    },\n  };\n});\nreturn updatedItems;\n"
      },
